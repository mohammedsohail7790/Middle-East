# Halla AI — Environment template (copy to .env and fill in real values)
# Domain: hallaai.com | Market: GCC / Middle East
# NEVER commit real secrets to git.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gateway database (Supabase pooler, port 6543)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
GATEWAY_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
PGSSLMODE=require

# Redis
REDIS_URL=redis://localhost:6379

# AI / Voice — OpenAI Realtime API handles STT + LLM + TTS in one connection
# No separate Deepgram or ElevenLabs key needed for calls
OPENAI_API_KEY=sk-your-openai-key

# Twilio — replace with your actual purchased number (change this when you buy a new number)
# GCC numbers: +966 (KSA), +971 (UAE), +974 (Qatar), +973 (Bahrain), +965 (Kuwait)
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+966xxxxxxxxx
TWILIO_STREAM_WSS_URL=wss://your-gateway-host/ws/realtime

# Auth
JWT_SECRET=generate-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
VOICE_INTERNAL_API_KEY=generate-a-long-random-string
INTERNAL_API_KEY=generate-a-long-random-string
ADMIN_API_KEY=generate-a-long-random-string
ALLOWED_ORIGINS=https://www.hallaai.com,https://hallaai.com,https://app.hallaai.com

# Rate limits (requests per minute)
RATE_LIMIT_PUBLIC_PER_MIN=20
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_USER_PER_MIN=60
RATE_LIMIT_LLM_PER_MIN=10
IP_RATE_LIMIT_MAX=120
SSE_TOKEN_TTL_SEC=300

# Stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Dashboard — Vercel app.hallaai.com (production) / localhost (dev)
NEXT_PUBLIC_GATEWAY_API_URL=https://gateway.hallaai.com
NEXT_PUBLIC_GATEWAY_WS_URL=wss://gateway.hallaai.com
DASHBOARD_URL=https://app.hallaai.com
NEXT_PUBLIC_SITE_URL=https://www.hallaai.com

# OAuth (Gateway + provider consoles — redirect to DASHBOARD_URL/dashboard/integrations)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gateway.hallaai.com/api/v1/calendar/google/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://gateway.hallaai.com/api/v1/integrations/slack/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=https://gateway.hallaai.com/api/v1/integrations/hubspot/callback
# Must match HubSpot developer app Auth → Required scopes exactly (space-separated).
# HUBSPOT_OAUTH_SCOPES=crm.objects.contacts.read crm.objects.contacts.write crm.objects.deals.read crm.objects.deals.write crm.objects.contracts.read
# Optional scopes (optional_scope= param). Leave unset for notes.write, or set empty to disable.
# HUBSPOT_OAUTH_OPTIONAL_SCOPES=crm.objects.notes.write

# Microsoft / Outlook
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=https://gateway.hallaai.com/api/v1/calendar/outlook/callback

# Calendly
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=https://gateway.hallaai.com/api/v1/calendar/calendly/callback

# Acuity
ACUITY_CLIENT_ID=
ACUITY_CLIENT_SECRET=
ACUITY_REDIRECT_URI=https://gateway.hallaai.com/api/v1/calendar/acuity/callback

# Pipedrive
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=

# Jobber
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=https://gateway.hallaai.com/api/v1/integrations/jobber/callback
JOBBER_API_VERSION=2025-04-16

# Salesforce
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Zoho CRM (popular in ME/GCC)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Freshsales (popular in ME/GCC)
FRESHSALES_CLIENT_ID=
FRESHSALES_CLIENT_SECRET=
FRESHSALES_OAUTH_SCOPES=freshsales.contacts.create freshsales.contacts.upsert freshsales.contacts.filters.view freshsales.selectors.view

# WhatsApp Business (META — primary channel for GCC)
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=generate-a-random-string

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
EMAIL_FROM=noreply@hallaai.com

# Sentry
SENTRY_DSN=

# Feature flags
HALLA_ENTERPRISE_RBAC=false
HALLA_AI_EMERGENCY_DISABLE=false
HALLA_P3_GOVERNANCE=false

# Localisation defaults (GCC / Middle East)
# Supported languages: ar-SA (Saudi Arabic), en (English), hi (Hindi), ru (Russian)
# Default timezone for new tenants — Asia/Dubai covers UAE, KSA uses Asia/Riyadh
DEFAULT_TIMEZONE=Asia/Dubai
DEFAULT_CURRENCY=AED
DEFAULT_LANGUAGE=ar-SA
