# Call IQ Dashboard — copy to .env.local (local) or set in Vercel (production)

# ─── Production (Vercel + Render gateway) ───
# Set for Production AND Preview in Vercel so branch deploys can reach Render.
NEXT_PUBLIC_GATEWAY_API_URL=https://call-iq-gateway.onrender.com
NEXT_PUBLIC_GATEWAY_WS_URL=wss://call-iq-gateway.onrender.com
NEXT_PUBLIC_SITE_URL=https://www.calliqlabs.com

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER prefix with NEXT_PUBLIC_. Used by Next.js API routes → gateway.
VOICE_INTERNAL_API_KEY=generate-a-secure-random-string

# Must match gateway JWT_SECRET if used server-side (server-only, not NEXT_PUBLIC_)
JWT_SECRET=your-jwt-secret

# ─── Local dev only (optional) ───
# NEXT_PUBLIC_GATEWAY_API_URL=http://localhost:3000
# NEXT_PUBLIC_USE_SAME_ORIGIN_API=true
# GATEWAY_PROXY_URL=http://localhost:3003
# NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:3003

# Site URL: https://www.calliqlabs.com
# Redirect URLs (add all):
#   https://www.calliqlabs.com/auth/callback
#   https://calliqlabs.com/auth/callback
#   http://localhost:3000/auth/callback
# Do NOT leave Site URL as http://localhost:3000 in production — email links will fail.

# Zapier — shared template URLs (Zapier → Share → copy link). One per CRM = true one-click for clients.
# NEXT_PUBLIC_ZAPIER_TEMPLATE_PIPEDRIVE=https://zapier.com/shared/...
# NEXT_PUBLIC_ZAPIER_TEMPLATE_FRESHSALES=https://zapier.com/shared/...
