{
    "name": "@call-iq/gateway",
    "version": "1.0.0",
    "type": "module",
    "main": "dist/apps/gateway/src/index.js",
    "exports": {
        ".": "./dist/apps/gateway/src/index.js",
        "./workers": {
            "types": "./src/workers/index.ts",
            "import": "./dist/apps/gateway/src/workers/index.js"
        },
        "./security/production-safety": {
            "types": "./src/security/production-safety.ts",
            "import": "./dist/apps/gateway/src/security/production-safety.js"
        }
    },
    "scripts": {
        "dev": "npx --yes cross-env PORT=3003 tsx watch src/index.ts",
        "build": "node build.cjs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src --max-warnings=0",
        "start": "node dist/apps/gateway/src/index.js",
        "test:synthetic": "tsx tests/synthetic-callers/run-tests.ts",
        "test:synthetic:single": "tsx tests/synthetic-callers/run-tests.ts single",
        "test:synthetic:batch": "tsx tests/synthetic-callers/run-tests.ts batch",
        "test:synthetic:load": "tsx tests/synthetic-callers/run-tests.ts load",
        "test:synthetic:all": "tsx tests/synthetic-callers/run-tests.ts all"
    },
    "dependencies": {
        "@azure/msal-node": "^5.1.5",
        "@call-iq/types": "*",
        "@microsoft/microsoft-graph-client": "^3.0.7",
        "@sentry/node": "^10.57.0",
        "@sentry/profiling-node": "^10.57.0",
        "@supabase/supabase-js": "^2.105.3",
        "bullmq": "^5.76.1",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "googleapis": "^171.4.0",
        "helmet": "^7.1.0",
        "ioredis": "^5.3.2",
        "jsonwebtoken": "^9.0.3",
        "mammoth": "^1.12.0",
        "morgan": "^1.10.0",
        "node-fetch": "^2.7.0",
        "nodemailer": "^9.0.1",
        "pdf-parse": "^2.4.5",
        "pdfkit": "0.15.0",
        "pg": "^8.20.0",
        "prom-client": "^15.1.3",
        "resend": "^6.12.2",
        "stripe": "^22.1.0",
        "twilio": "^6.0.0",
        "uuid": "^13.0.0",
        "winston": "^3.11.0",
        "ws": "^8.14.2"
    },
    "devDependencies": {
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/morgan": "^1.9.9",
        "@types/node": "^20.0.0",
        "@types/node-fetch": "^2.6.13",
        "@types/pdfkit": "0.13.9",
        "@types/uuid": "^10.0.0",
        "@types/ws": "^8.5.10",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "tsx": "^4.0.0",
        "typescript": "^5.0.0"
    }
}
