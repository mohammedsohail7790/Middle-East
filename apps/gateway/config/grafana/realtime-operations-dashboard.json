{
  "dashboard": {
    "title": "Call IQ - Realtime Operations",
    "tags": ["call-iq", "realtime", "operations"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Active Sessions",
        "type": "graph",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum(calliq_sessions_active) by (tenant_id)",
            "legendFormat": "{{tenant_id}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "short", "label": "Sessions" },
          { "format": "short" }
        ]
      },
      {
        "id": 2,
        "title": "Session Creation Rate",
        "type": "graph",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(calliq_sessions_total[5m])",
            "legendFormat": "Sessions/sec",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "WebSocket Connections",
        "type": "graph",
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum(calliq_websocket_connections_active) by (endpoint)",
            "legendFormat": "{{endpoint}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Audio Frame Throughput",
        "type": "graph",
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(calliq_audio_frames_received_total[1m])",
            "legendFormat": "Received",
            "refId": "A"
          },
          {
            "expr": "rate(calliq_audio_frames_sent_total[1m])",
            "legendFormat": "Sent",
            "refId": "B"
          },
          {
            "expr": "rate(calliq_audio_frames_dropped_total[1m])",
            "legendFormat": "Dropped",
            "refId": "C"
          }
        ]
      },
      {
        "id": 5,
        "title": "Audio Latency (P95)",
        "type": "graph",
        "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(calliq_audio_latency_milliseconds_bucket[5m]))",
            "legendFormat": "P95 Latency",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "ms", "label": "Latency" },
          { "format": "short" }
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": { "params": [800], "type": "gt" },
              "operator": { "type": "and" },
              "query": { "params": ["A", "5m", "now"] },
              "reducer": { "params": [], "type": "avg" },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "60s",
          "handler": 1,
          "name": "High Audio Latency",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 6,
        "title": "Session Failures",
        "type": "graph",
        "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(calliq_session_failures_total[5m])",
            "legendFormat": "{{reason}}",
            "refId": "A"
          },
          {
            "expr": "rate(calliq_zombie_sessions_total[5m])",
            "legendFormat": "Zombies",
            "refId": "B"
          },
          {
            "expr": "rate(calliq_orphan_sessions_total[5m])",
            "legendFormat": "Orphans",
            "refId": "C"
          }
        ]
      },
      {
        "id": 7,
        "title": "Tool Execution Duration (P95)",
        "type": "graph",
        "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(calliq_tool_execution_duration_seconds_bucket[5m])) by (tool_name)",
            "legendFormat": "{{tool_name}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "s", "label": "Duration" },
          { "format": "short" }
        ]
      },
      {
        "id": 8,
        "title": "Redis Operation Latency",
        "type": "graph",
        "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(calliq_redis_operation_duration_milliseconds_bucket[5m])) by (operation)",
            "legendFormat": "{{operation}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "ms", "label": "Latency" },
          { "format": "short" }
        ]
      },
      {
        "id": 9,
        "title": "Memory Usage",
        "type": "graph",
        "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "calliq_memory_usage_bytes{type='heap_used'} / 1024 / 1024",
            "legendFormat": "Heap Used (MB)",
            "refId": "A"
          },
          {
            "expr": "calliq_memory_usage_bytes{type='heap_total'} / 1024 / 1024",
            "legendFormat": "Heap Total (MB)",
            "refId": "B"
          },
          {
            "expr": "calliq_memory_usage_bytes{type='rss'} / 1024 / 1024",
            "legendFormat": "RSS (MB)",
            "refId": "C"
          }
        ],
        "yaxes": [
          { "format": "mbytes", "label": "Memory" },
          { "format": "short" }
        ]
      },
      {
        "id": 10,
        "title": "Event Loop Lag",
        "type": "graph",
        "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(calliq_event_loop_lag_milliseconds_bucket[5m]))",
            "legendFormat": "P95 Lag",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "ms", "label": "Lag" },
          { "format": "short" }
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": { "params": [100], "type": "gt" },
              "operator": { "type": "and" },
              "query": { "params": ["A", "5m", "now"] },
              "reducer": { "params": [], "type": "avg" },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "60s",
          "handler": 1,
          "name": "High Event Loop Lag",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 11,
        "title": "OpenAI API Latency",
        "type": "graph",
        "gridPos": { "x": 0, "y": 40, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(calliq_openai_latency_milliseconds_bucket[5m]))",
            "legendFormat": "P95 Latency",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "ms", "label": "Latency" },
          { "format": "short" }
        ]
      },
      {
        "id": 12,
        "title": "Business Metrics",
        "type": "stat",
        "gridPos": { "x": 12, "y": 40, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum(increase(calliq_bookings_created_total[1h]))",
            "legendFormat": "Bookings (1h)",
            "refId": "A"
          },
          {
            "expr": "sum(increase(calliq_leads_captured_total[1h]))",
            "legendFormat": "Leads (1h)",
            "refId": "B"
          },
          {
            "expr": "sum(increase(calliq_calls_transferred_total[1h]))",
            "legendFormat": "Transfers (1h)",
            "refId": "C"
          }
        ]
      }
    ]
  }
}
