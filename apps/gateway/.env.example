# Call IQ Gateway — Production Environment Variables
# Copy to .env and fill in all values before deployment

# ─── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3003

# ─── Database ───────────────────────────────────────────────────────────────
# Supabase/PostgreSQL connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ─── Redis ──────────────────────────────────────────────────────────────────
# Upstash or Redis connection string
REDIS_URL=redis://[PASSWORD]@[HOST]:[PORT]

# ─── Security & Auth ────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# From Supabase Dashboard → Settings → API → JWT Secret (improves session verification)
SUPABASE_JWT_SECRET=
VOICE_INTERNAL_API_KEY=<generate-a-secure-random-string>
# AES-256-GCM key for encrypted integration credentials (integration_connections table)
# Generate: openssl rand -base64 32
INTEGRATION_CREDENTIALS_KEY=<openssl-rand-base64-32>
JWT_SECRET=<generate-a-secure-random-string>
ADMIN_API_KEY=<super-admin-key-for-tenant-management>

# ─── AI Services ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=12000

# Optional: Twilio Lookup for spam caller reputation
# TWILIO_LOOKUP_API_KEY=
# TWILIO_ADDRESS_SID=  # Phone porting regulatory bundle
DEEPGRAM_API_KEY=<your-deepgram-api-key>

# ─── Text-to-Speech ─────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=<your-elevenlabs-api-key>

# ─── Twilio ─────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
# Public gateway URL for inbound webhooks + outbound TwiML (HTTPS). wss:// is converted to https://
TWILIO_STREAM_WSS_URL=wss://call-iq-gateway.onrender.com
GATEWAY_PUBLIC_URL=https://call-iq-gateway.onrender.com
# Optional: destination for onboarding "Ring test number" (defaults to +18005551234)
TEST_CALL_NUMBER=+1xxxxxxxxxx
TWILIO_ALLOWED_IPS=

# ─── WebSocket Security ─────────────────────────────────────────────────────
VOICE_WS_ALLOWED_ORIGINS=https://www.calliqlabs.com,https://calliqlabs.com
VOICE_WS_ALLOWED_IPS=

# ─── CORS ───────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://www.calliqlabs.com,https://calliqlabs.com

# ─── Stripe Billing ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Option A (recommended): Stripe product IDs — gateway resolves price_... at runtime
STRIPE_ESSENTIAL_PRODUCT_ID_MONTHLY=prod_UevJDYfmBcR9Id
STRIPE_ESSENTIAL_PRODUCT_ID_ANNUAL=prod_UevhigbubpTIss
STRIPE_PROFESSIONAL_PRODUCT_ID_MONTHLY=prod_Ueva77AVpYACtF
STRIPE_PROFESSIONAL_PRODUCT_ID_ANNUAL=prod_Uevj6K92uWuwiv
STRIPE_ENTERPRISE_PRODUCT_ID_MONTHLY=prod_UevdxRtmxkh3eu
STRIPE_ENTERPRISE_PRODUCT_ID_ANNUAL=prod_UevlpEGDaFqVmB

# Option B: explicit Stripe price IDs (override product resolution)
# STRIPE_ESSENTIAL_PRICE_ID=price_...
# STRIPE_ESSENTIAL_ANNUAL_PRICE_ID=price_...
# STRIPE_PROFESSIONAL_PRICE_ID=price_...
# STRIPE_PROFESSIONAL_ANNUAL_PRICE_ID=price_...
# STRIPE_ENTERPRISE_PRICE_ID=price_...
# STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=price_...

# Optional metered overage prices (skip until configured in Stripe)
# STRIPE_ESSENTIAL_OVERAGE_ID=price_...
# STRIPE_PROFESSIONAL_OVERAGE_ID=price_...
# STRIPE_ENTERPRISE_OVERAGE_ID=price_...

# ─── Voice Pipeline ─────────────────────────────────────────────────────────
VOICE_SILENCE_TIMEOUT_MS=6000
VOICE_MAX_CALL_DURATION_MS=900000
VOICE_MAX_TOKENS_PER_CALL=5000
VOICE_MAX_SILENCE_PROMPTS=3
VOICE_RATE_LIMIT_WINDOW_MS=60000
VOICE_RATE_LIMIT_MAX=60
VOICE_USAGE_KEY_TTL_SECONDS=2592000

# ─── API Rate Limiting (per minute, sliding window) ───────────────────────────
RATE_LIMIT_PUBLIC_PER_MIN=20
RATE_LIMIT_PUBLIC_READ_PER_MIN=60
RATE_LIMIT_WEBHOOK_PER_MIN=120
RATE_LIMIT_HEALTH_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_USER_PER_MIN=180
RATE_LIMIT_BEARER_USER_PER_MIN=300
RATE_LIMIT_AUTH_IP_PER_MIN=300
RATE_LIMIT_REALTIME_PER_MIN=600
RATE_LIMIT_LLM_PER_MIN=10
IP_RATE_LIMIT_MAX=120
MAX_QUERY_STRING_LEN=2000
MAX_BODY_KEY_COUNT=200
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SSE_TOKEN_TTL_SEC=300
# Optional: previous JWT_SECRET so live dashboard SSE tokens survive secret rotation
JWT_SECRET_PREVIOUS=
INTERNAL_API_KEY=<same-as-or-separate-from-VOICE_INTERNAL_API_KEY>
TWILIO_SKIP_SIGNATURE_VALIDATION=false

# ─── Knowledge Base ─────────────────────────────────────────────────────────
ENABLE_KNOWLEDGE_INGESTION=true

# ─── Integrations ───────────────────────────────────────────────────────────
INTEGRATION_RETRY_INTERVAL_MS=30000
INTEGRATION_MAX_RETRIES=5

# ─── Billing ────────────────────────────────────────────────────────────────
STRIPE_TRIAL_DAYS=14

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@calliqlabs.com

# ─── Google Calendar ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
# Must match Google Cloud → Authorized redirect URIs (use gateway URL or www + Vercel proxy)
GOOGLE_REDIRECT_URI=https://call-iq-gateway.onrender.com/api/v1/calendar/google/callback

# ─── Outlook Calendar (Microsoft Graph) ─────────────────────────────────────
MS_CLIENT_ID=<your-azure-ad-client-id>
MS_CLIENT_SECRET=<your-azure-ad-client-secret>
MS_TENANT_ID=common
MS_REDIRECT_URI=https://call-iq-gateway.onrender.com/api/v1/calendar/outlook/callback

# ─── Calendly OAuth ─────────────────────────────────────────────────────────
CALENDLY_CLIENT_ID=<your-calendly-client-id>
CALENDLY_CLIENT_SECRET=<your-calendly-client-secret>
# Must match Calendly developer app redirect URI exactly
CALENDLY_REDIRECT_URI=https://call-iq-gateway.onrender.com/api/v1/calendar/calendly/callback
# Webhook signing key from Calendly OAuth app (Developer → your app)
CALENDLY_WEBHOOK_SIGNING_KEY=<your-calendly-webhook-signing-key>

# ─── Acuity Scheduling OAuth ────────────────────────────────────────────────
ACUITY_CLIENT_ID=
ACUITY_CLIENT_SECRET=
# Must match Acuity developer app redirect URI exactly
ACUITY_REDIRECT_URI=https://call-iq-gateway.onrender.com/api/v1/calendar/acuity/callback

# ─── Square Appointments OAuth ──────────────────────────────────────────────
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
# Must match Square developer app redirect URI exactly
SQUARE_REDIRECT_URI=https://call-iq-gateway.onrender.com/api/v1/calendar/square-appointments/callback

# ─── Jobber OAuth ───────────────────────────────────────────────────────────
# Callback URL (exact): https://call-iq-gateway.onrender.com/api/v1/integrations/jobber/callback
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=https://call-iq-gateway.onrender.com/api/v1/integrations/jobber/callback
JOBBER_API_VERSION=2025-04-16

# ─── Salesforce OAuth (classic Connected App — NOT External Client App) ─────
# Setup → App Manager → New Connected App → Enable OAuth Settings
# Callback URL (exact): https://call-iq-gateway.onrender.com/api/v1/integrations/salesforce/callback
# OAuth scopes: api, refresh_token (or Full access + Perform requests at any time)
# External Client Apps cannot authenticate customers from other orgs — use Connected App only.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Optional: use test.salesforce.com for sandbox-only orgs
# SALESFORCE_LOGIN_URL=https://login.salesforce.com

# ─── Pipedrive OAuth (CRM — one-click connect in dashboard) ─────────────────
# Create app: https://developers.pipedrive.com/ → Developer Hub → Create app
# Callback URL (exact): https://call-iq-gateway.onrender.com/api/v1/integrations/pipedrive/callback
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=

# ─── Freshsales OAuth (CRM — org domain + OAuth connect in dashboard) ───────
# Create OAuth app in Freshworks Developer Portal for Call IQ
# Callback URL (exact): https://call-iq-gateway.onrender.com/api/v1/integrations/freshsales/callback
# Scopes (must match Developer Portal): contacts.create upsert filters.view selectors.view
FRESHSALES_CLIENT_ID=
FRESHSALES_CLIENT_SECRET=
# Optional override (space-separated)
FRESHSALES_OAUTH_SCOPES=

# ─── Zoho CRM OAuth (Server-based Application in Zoho API Console) ─────────
# Callback URL (exact): https://call-iq-gateway.onrender.com/api/v1/integrations/zoho/callback
# Scopes: ZohoCRM.modules.leads.CREATE, ZohoCRM.modules.leads.READ, ZohoCRM.users.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# ─── Copper OAuth (register app with Copper — partners@copper.com) ───────────
# Callback URL (exact, GET or POST): https://call-iq-gateway.onrender.com/api/v1/integrations/copper/callback
# Scope: developer/v1/all
COPPER_CLIENT_ID=
COPPER_CLIENT_SECRET=

# ─── Clio OAuth (developer app in Clio Developer Portal) ───────────────────
# Callback URL (exact): https://call-iq-gateway.onrender.com/api/v1/integrations/clio/callback
# Deauthorize URL: https://call-iq-gateway.onrender.com/api/v1/integrations/clio/deauthorize
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
# Optional scopes (space-separated): contacts:write users:read
CLIO_OAUTH_SCOPES=

# ─── Square Appointments OAuth ─────────────────────────────────────────────
# Callback URL (exact): https://call-iq-gateway.onrender.com/api/v1/calendar/square-appointments/callback
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
SQUARE_REDIRECT_URI=https://call-iq-gateway.onrender.com/api/v1/calendar/square-appointments/callback

# ─── ServiceTitan OAuth (developer app in ServiceTitan Developer Portal) ───
# Callback URL (exact): https://call-iq-gateway.onrender.com/api/v1/integrations/servicetitan/callback
SERVICETITAN_CLIENT_ID=
SERVICETITAN_CLIENT_SECRET=

# ─── Jobber OAuth ───────────────────────────────────────────────────────────
# Callback URL (exact): https://call-iq-gateway.onrender.com/api/v1/integrations/jobber/callback
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=https://call-iq-gateway.onrender.com/api/v1/integrations/jobber/callback
JOBBER_API_VERSION=2025-04-16

# ─── Slack OAuth ────────────────────────────────────────────────────────────
# Create app: https://api.slack.com/apps → Create New App → From scratch
# OAuth & Permissions → Redirect URL: https://call-iq-gateway.onrender.com/api/v1/integrations/slack/callback
# Bot Token Scopes: incoming-webhook, chat:write
# Manage Distribution → Activate (required for workspaces other than the dev workspace)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ─── Dashboard URL ──────────────────────────────────────────────────────────
DASHBOARD_URL=https://www.calliqlabs.com

# ─── Production safety (NEVER set in production) ────────────────────────────
# DEV_TENANT_ID=                    # Skips billing checks for one tenant — development only
# ALLOW_INSECURE_TLS=true           # Disables TLS cert validation — local dev only
# USAGE_ENFORCEMENT_FAIL_OPEN=true  # Allows calls when billing check fails — never in prod
# ALLOWLIST_FAIL_OPEN=true          # Ignored in production; bypasses IP allowlist on DB outage

# ─── HIPAA Compliance ───────────────────────────────────────────────────────
# Set REDIS_PASSWORD when Redis URL does not embed credentials (HIPAA §164.312).
# If REDIS_URL already contains a password (redis://:pass@host) leave this blank.
REDIS_PASSWORD=

# Set REDIS_TLS=true to force TLS for Redis connections in production.
# rediss:// URLs enable TLS automatically. Use redis:// only on localhost.
REDIS_TLS=true

# Path to CA certificate bundle for verifying the Postgres server certificate.
# HIPAA requires the DB transport to be verified (TLS MITM protection).
# Supabase root CA: download from https://supabase.com/docs/guides/database/connecting-to-postgres
# Leave blank to use the system CA bundle (valid for Supabase's public-CA-signed cert).
PG_SSL_CA=

# Allow insecure TLS for Postgres in local dev ONLY — never set in production.
# When true, PG cert validation is skipped (used by docker-compose local DB).
# ALLOW_INSECURE_TLS=true

# Signed URL TTL for call recordings (seconds). Default: 3600 (1 hour).
# HIPAA tenants use storage:// paths; signed URLs are generated at read time.
RECORDING_URL_TTL_SECONDS=3600

# RBAC mode: defaults to ON. Set to false only in local dev/testing to bypass role checks.
# CALLIQ_ENTERPRISE_RBAC=false
